# RCA Smart Copilot for SAP CPI — backend config
# Copy to .env and fill in. Never commit .env.

# App
RCA_ENV=demo                 # demo | live
RCA_MASTER_KEY=              # 32-byte base64 key for AES-256-GCM secret encryption (generate one)

# Persistence & auth
DATABASE_URL=sqlite+aiosqlite:///./instance/rca.db   # Postgres: postgresql+asyncpg://user:pass@host:5432/rca
JWT_SECRET=                  # HS256 secret; auto-generated + persisted to instance/.jwt_secret if blank
JWT_EXPIRE_MINUTES=1440      # token lifetime (24h)

# SAP CPI design-time (Integration Suite service key)
CPI_BASE_URL=                # Service Key -> url  (e.g. https://<tenant>.it-cpi0xx.cfapps.<region>.hana.ondemand.com)
CPI_TOKEN_URL=               # Service Key -> tokenurl  (append /oauth/token if missing)
CPI_CLIENT_ID=               # Service Key -> clientid
CPI_CLIENT_SECRET=           # Service Key -> clientsecret

# When RCA_ENV=demo the connector serves bundled demo data and the above can stay blank.
